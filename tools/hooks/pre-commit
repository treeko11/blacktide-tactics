#!/bin/sh
#
# Refuses a commit that would put personal information into this public
# repository. The rules, and why they exist, are in personal-info.sh.
#
# Anything naming a person goes in an untracked `private_patterns.txt`, NOT in
# a hook: the hooks are tracked, and therefore public, so a name written into
# one is exactly the leak it was meant to stop.
#
# Active because core.hooksPath points at tools/hooks. A fresh clone has to set
# that itself - hooks are not cloned. `git commit --no-verify` skips this, but
# fix the pattern rather than making that a habit; the habit is how the address
# gets pushed.

# A commit piped into `head` closes the pipe under this hook mid-report, and a
# hook killed by SIGPIPE never reaches its `exit 1` - so the commit it had
# already decided to block goes through anyway. Ignoring the signal lets the
# writes fail and the exit code stand.
trap '' PIPE

. "$(git rev-parse --show-toplevel)/tools/hooks/personal-info.sh"

pi_check_email "the author email"    "$(git var GIT_AUTHOR_IDENT    | sed -n 's/.*<\(.*\)>.*/\1/p')"
pi_check_email "the committer email" "$(git var GIT_COMMITTER_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')"

pi_scan "$(git diff --cached -U0 --diff-filter=ACM | grep '^+' | grep -v '^+++')"

if pi_failed; then
    printf '\n  Nothing was committed. Fix the lines above, or --no-verify if wrong.\n\n'
    exit 1
fi

exit 0
