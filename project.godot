; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Blacktide Tactics"
config/description="A pirate-themed auto battler."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

; Order matters. Events has no dependencies. Content must load the champion,
; trait and item definitions before GameState fills the shared champion pool.
Events="*res://scripts/autoload/events.gd"
Content="*res://scripts/autoload/content.gd"
GameState="*res://scripts/autoload/game_state.gd"

; DEV BUILD ONLY. Delete this line and scripts/dev/ before release; nothing in
; the game references either, so there is nothing else to unpick.
Dev="*res://scripts/dev/dev.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

; Godot's own drag-and-drop is mouse-driven, and moving a pirate from the bench
; to the board is the central verb of the game. Emulating a mouse from touch is
; what makes a finger able to do it at all.
pointing/emulate_mouse_from_touch=true

[rendering]

textures/canvas_textures/default_texture_filter=0
